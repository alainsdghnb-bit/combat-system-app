{
  "name": "combat-system-local",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run test && npm run validate-app",
    "serve": "python3 -m http.server 4173 -d dist",
    "validate-app": "npm run build && node scripts/validate-app.mjs",
    "android:sync": "npm run build && node scripts/sync-android.mjs",
    "android:validate": "node scripts/validate-android.mjs",
    "verify:all": "npm run verify && npm run android:sync && npm run android:validate"
  }
}
